#!/usr/bin/env bash
set -euo pipefail

readonly database_path="/var/lib/docker/volumes/deploy_vocabulary_data/_data/vocabulary.sqlite"
readonly backup_directory="/var/backups/vocabulary"
readonly s3_config="/root/.s3cfg"
readonly s3_bucket="vocabulary-backups-2026"
readonly timestamp="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
readonly snapshot_path="${backup_directory}/vocabulary-${timestamp}.sqlite"
readonly archive_path="${snapshot_path}.gz"

cleanup() {
  rm -f "$snapshot_path" "$archive_path"
}
trap cleanup EXIT

test -r "$database_path"
test -r "$s3_config"
mkdir -p "$backup_directory"
chmod 700 "$backup_directory"

sqlite3 "$database_path" ".timeout 30000" ".backup '$snapshot_path'"

if [[ "$(sqlite3 "$snapshot_path" 'PRAGMA integrity_check;')" != "ok" ]]; then
  echo "SQLite integrity check failed" >&2
  exit 1
fi

chmod 600 "$snapshot_path"
gzip -9 "$snapshot_path"
s3cmd --config="$s3_config" put --no-progress "$archive_path" \
  "s3://${s3_bucket}/daily/$(basename "$archive_path")"

echo "Backup uploaded: s3://${s3_bucket}/daily/$(basename "$archive_path")"
